# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@profiletter.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Primary Postgres (Fly Postgres or other)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profiletter?schema=public

# Optional backup / secondary Postgres (e.g. Supabase)
# When set, health checks can verify connectivity; write failover is future work.
BACKUP_DATABASE_URL=

# Redis (rate limit / cache / jobs)
REDIS_URL=redis://localhost:6379

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# Twenty CRM / MCP gateway
TWENTY_API_URL=
TWENTY_API_KEY=
MCP_ENABLED=true
CRM_WRITE_ENABLED=false
