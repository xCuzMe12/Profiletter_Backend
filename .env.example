# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Atomic CRM Vite app
CORS_ORIGIN=http://localhost:5173

# Auth (Profiletter API JWT + optional Supabase SSO)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@profiletter.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Postgres for chat conversations / users (Fly Postgres or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profiletter?schema=public

# Optional backup URL
BACKUP_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# Atomic CRM (Supabase) — Stranke/Leads system of record
# Local: npx supabase status -o env inside web/
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

MCP_ENABLED=true
CRM_WRITE_ENABLED=false
